# Copy to .env and fill in real values locally. Never commit the real .env file.

# Authentication for THIS service (clients send it as the X-API-Key header).
# Required when APP_ENV=production; leave empty only for local development.
SERVICE_API_KEY=

# External billing API we ingest from
API_BASE_URL=https://example.com/api/billing
API_KEY=changeme
API_TIMEOUT_SECONDS=10
API_MAX_RETRIES=3

# MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=billing_migration
MYSQL_USER=your_mysql_user
MYSQL_PASSWORD=your_mysql_password
MYSQL_ROOT_PASSWORD=your_mysql_root_password

# App
# development | docker | production (production enforces secrets)
APP_ENV=development
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
