# Copy to .env and fill in real values locally. Never commit the real .env file.

# External billing API
API_BASE_URL=https://example.com/api/billing
API_KEY=changeme

# MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=billing_migration
MYSQL_USER=your_mysql_user
MYSQL_PASSWORD=your_mysql_password
MYSQL_ROOT_PASSWORD=your_mysql_root_password

# App
APP_ENV=local
LOG_LEVEL=INFO
